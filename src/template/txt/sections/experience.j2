{# flatten_roles re-expands an employer that holds several roles into one block
   per role, repeating the company header each time -- classic nests them under
   a single header, this layout deliberately does not. See the filter's
   docstring in generate_cv.py. #}
{% for item in experience | flatten_roles %}
{# A remote location like "Remote (Brazil -- US)" reads fine on a page but
   confuses an ATS's location field parser, which expects a single place
   name -- collapse it to the bare "Remote" here. Other layouts are read by
   a person or a scanner that handles the parenthetical fine, so this is
   txt-only. #}
{{ item.company.name }}{% if item.location %}, {{ item.location | simplify_remote_location }}{% endif +%}
{{ item.title }}
{# No computed duration here, matching ats: a plain-text/ATS reader already
   has both dates and can work out tenure itself; the "(X years, Y months)"
   is a readability aid for a human, which is what classic is for. #}
{{ item.duration.start | as_date(fmt_month_year) }} - {{ item.duration.end | as_date(fmt_month_year) }}
{% if item.company.url %}
{{ item.company.url }}
{% endif %}
{# Skip the employer blurb per company.show_description, resolved from
   companies[].is_well_known and --company-descriptions (see
   classic/sections/experience.j2). #}
{% if item.company.description and item.company.show_description %}

{{ item.company.description }}
{% endif %}
{% if item.description %}

{{ item.description }}
{% endif %}
{% if item.achievements %}

{% for achievement in item.achievements %}
- {{ achievement }}
{% endfor %}
{% endif %}
{% if item.technologies %}
Technologies: {{ item.technologies | join(', ') }}
{% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}
