{# Flat, comma-separated keyword lines under an explicit label: this is the
   shape skill extractors are built around. The labels come from the data (an
   ordered list of {label, items} groups), so a scanner sees one line per
   domain rather than three fixed buckets. Spoken languages are their own
   section.

   group["items"], not group.items -- Jinja resolves attributes first, and on
   a dict `.items` is the built-in method. #}
{% for group in skills %}
\textbf{ {{- group.label | latex_escape -}} :} {{ group["items"] | join(', ') | latex_escape }}
{% endfor %}
