{% for item in experience %}
	{\bf {{ item.company.name | latex_escape }}}, {\sl {{ item.location | latex_escape }}} \hfill {\sl {{ item.duration.start | as_date(fmt_month_year) }} -- {{ item.duration.end | as_date(fmt_month_year) }}} \\
	{\sl — {% if links %}\href{ {{ item.company.url }} }{ {{ item.company.url }} }{% else %}\weburl{ {{- item.company.url -}} }{% endif %}} \\
	{\sl {{ item.title | latex_escape }} } \hfill {\sl ({{ parse_duration(item.duration.start, item.duration.end) }})} \\
	{%- if item.company.description %}
	\\
	{{ item.company.description | latex_escape }}
	{%- endif %}
	{%- if item.description %}
	\\
	{{ item.description | latex_escape }}
	{%- endif %}
	{%- if item.achievements %}
	\begin{itemize}
		{%- for achievement in item.achievements %}
		\item {{ achievement | latex_escape }}
		{%- endfor %}
	\end{itemize}
	{%- else %}
	\\
	{%- endif %}
	{\sl Technologies: {{ item.technologies | join(', ') | latex_escape }} }
	\\
{% endfor %}
