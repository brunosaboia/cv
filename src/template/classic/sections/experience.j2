{#- A role's body -- description, achievement bullets, technologies -- reads the
   same whether it hangs off a lone role or is one of several under a shared
   company header, so it is written once here rather than twice below.

   trailing_skip is appended to the closing \\ so the grouped branch can widen
   the gap after every role but the last (\\[\cvroleskip]). It defaults to
   empty, which is what makes the single-role branch emit the bare \\ it always
   has -- this file has to reproduce today's .tex byte for byte for every
   single-role entry, or the whole PDF reflows around the one that changed. #}
{%- macro role_body(role, trailing_skip='') -%}
{%- if role.description %}
	\\
	{{ role.description | latex_escape }}
{%- endif %}
{%- if role.achievements %}
	\begin{itemize}
		{%- for achievement in role.achievements %}
		\item {{ achievement | latex_escape }}
		{%- endfor %}
	\end{itemize}
{%- else %}
	\\
{%- endif %}
	{\sl Technologies: {{ role.technologies | join(', ') | latex_escape }} }
	\\{{ trailing_skip }}
{%- endmacro -%}
{% for item in experience %}
{#- One employer, one header. An entry that holds a single role is rendered
   exactly as it was before roles[] existed; only an employer with several
   roles (a promotion) takes the grouped branch, where the header carries the
   combined span and total tenure and each role hangs below it. ats and txt
   deliberately do the opposite and repeat the header per role -- see
   flatten_roles in generate_cv.py. #}
{%- if item.roles | length == 1 %}
{%- set role = item.roles[0] %}
	{#- Dates and duration ride together on the employer line, exactly as the
	   grouped branch's span and tenure do. They used to be split -- range
	   here, a lone "(9 months)" right-aligned on the title line below --
	   which put the same two facts in two different places depending only on
	   whether the employer happened to have one role or several. Bruno:
	   "make everything to be on the right side". Every employer block now
	   states its dates once, completely, on its first line. #}
	{\bf {{ item.company.name | latex_escape }}}, {\sl {{ item.location | latex_escape }}} \hfill {\sl {{ role.duration.start | as_date(fmt_month_year) }} -- {{ role.duration.end | as_date(fmt_month_year) }} ({{ parse_duration(role.duration.start, role.duration.end) }})} \\
	{%- if item.company.url %}
	{\sl — {% if links %}\href{ {{ item.company.url }} }{ {{ item.company.url }} }{% else %}\weburl{ {{- item.company.url -}} }{% endif %}} \\
	{%- endif %}
	{\sl {{ role.title | latex_escape }} } \\[\cvsubitemskip]
	{#- A household name (Google, a national central bank, ...) doesn't need a
	   blurb explaining what it is; that space is better spent on the role
	   itself. company.show_description is resolved once in generate_cv.py
	   from companies[].is_well_known and the build-wide --company-descriptions
	   level (min/mid/max) -- read the one flag here rather than either input
	   separately. #}
	{%- if item.company.description and item.company.show_description %}
	\\
	{{ item.company.description | latex_escape }}
	{%- endif %}
	{{- role_body(role) }}
{%- else %}
	{#- Span and total tenure share the header line, and they are the only
	   parenthesised figure in the group: each role below states its own dates
	   but not its own duration. Two right-aligned ranges a line apart -- the
	   employer's "May 2022 -- May 2025 (3 years)" sitting directly over the
	   first role's "May 2024 -- May 2025 (1 year)" -- read as one confused
	   pair rather than as a total and the first part of it. With the
	   per-role parenthetical gone there is exactly one duration in the block,
	   the employer's, and every role line answers only "when". #}
	{%- set has_blurb = item.company.description and item.company.show_description %}
	{#- \cvroleskip separates one role from the next and nothing else. It is
	   deliberately not applied before the first role: with no indent and no
	   gap, that role sits under its employer exactly as a single-role entry's
	   title does, so the two branches open identically and only a second role
	   costs any extra space. #}
	{\bf {{ item.company.name | latex_escape }}}, {\sl {{ item.location | latex_escape }}} \hfill {\sl {{ item.span.start | as_date(fmt_month_year) }} -- {{ item.span.end | as_date(fmt_month_year) }} ({{ parse_duration(item.span.start, item.span.end) }})} \\
	{%- if item.company.url %}
	{\sl — {% if links %}\href{ {{ item.company.url }} }{ {{ item.company.url }} }{% else %}\weburl{ {{- item.company.url -}} }{% endif %}} \\
	{%- endif %}
	{#- The blurb describes the employer, so in the grouped case it goes above
	   the roles rather than trailing one of them. #}
	{%- if has_blurb %}
	\\
	{{ item.company.description | latex_escape }} \\
	{%- endif %}
	{%- for role in item.roles %}
	{#- Flush left, like every other line in the block. The title used to be
	   pushed in by a \cvroleindent register to show it hanging under the employer,
	   which left it as the one line in the entry with a different left edge. Bold
	   employer against italic title already carries that distinction. #}
	{\sl {{ role.title | latex_escape }} } \hfill {\sl {{ role.duration.start | as_date(fmt_month_year) }} -- {{ role.duration.end | as_date(fmt_month_year) }}} \\[\cvsubitemskip]
	{{- role_body(role, '' if loop.last else '[\\cvroleskip]') }}
	{%- endfor %}
{%- endif %}
{% endfor %}
