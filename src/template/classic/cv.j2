\documentclass[margin]{res} % Use the res.cls style

% T1 encoding + Latin Modern: accented characters (ü, é, ...) become real
% glyphs instead of composed accents, so PDF text extraction (ATS, copy-paste)
% yields "Zürich" rather than "Z¨urich".
\usepackage[T1]{fontenc}
\usepackage{lmodern}

\usepackage{hyperref}
\hypersetup{
	colorlinks=true,
	linkcolor=blue,
	filecolor=magenta,
	urlcolor=cyan,
	% The opening brace is deliberately separated from the expression by a space:
	% written flush against the expression delimiters it would open a Jinja tag
	% instead, and the value would come out unbraced.
	pdftitle={ {{- personal.name | latex_escape }} - CV},
	pdfpagemode=FullScreen,
}

\usepackage{helvet}
\usepackage{graphicx}

{%- if not links %}

{% raw %}% Emitted only for --no-links, where an address that was hidden behind a
% label ("GitHub", "Transcript of records", a date) has to become readable text
% instead. A linked build never sees this, so it renders as it always has --
% including \emergencystretch, which changes line breaking document-wide and so
% must not leak into a linked build.
% Scoped \urlstyle{same} keeps the address in the body font and lets it break at
% / -- this layout's measure is 5.2in, so a bare URL would run into the margin.
\newcommand{\weburl}[1]{{\urlstyle{same}\nolinkurl{#1}}}
% The same, alone on its line and set ragged. A long address carries no
% interword glue to stretch, so a justified line cannot break inside one: the
% break would leave the previous line unstretchable and infinitely bad, and TeX
% takes an overfull box into the margin instead. Ragged setting gives the breaks
% somewhere to go. \parskip is 0 inside a list, so this costs only \parsep.
\newcommand{\weburlline}[1]{\par{\raggedright\weburl{#1}\par}}
% Backstop for the addresses that stay inline (header, employer, institution):
% short in practice, but this keeps a long one out of the margin.
\emergencystretch=3em{% endraw %}
{%- endif %}

\setlength{\textwidth}{5.2in} %default 5.1in % Text width of the document

% res.cls sets \parskip=\baselineskip (every paragraph break gets a full
% blank line) but \sectionskip=1.2ex -- smaller than \parskip. \section
% opens with \addvspace{\sectionskip}, which tops up to its argument rather
% than adding to it, so against a \baselineskip-sized \parskip it contributes
% nothing: a new section reads as just another paragraph. Doubling it to
% 2\baselineskip (the same ratio the ats layout uses between \cvsection's
% \addvspace and its own \parskip) is enough to read as a section break.
% This is also the "section" gap of the four below -- kept unchanged.
\newskip\cvsectionskip
\cvsectionskip=2\baselineskip plus 6pt minus 3pt

% Five independently tunable gaps, smallest to largest: \cvsubitemskip between
% an entry's own header (employer/title/dates) and its body (e.g. the role
% description or achievement bullets), \cvroleskip between two roles at the
% same employer, \cvitemskip between entries within a section (e.g. each
% employer in Experience, each degree in Education), \cvheaderskip between the
% contact header and the first section, \cvsectionskip (above) between one
% section and the next. \section always reads res.cls's own \sectionskip
% register at call time, so the header/for loop below swaps its value to
% \cvheaderskip only for the very first section.
\newskip\cvsubitemskip
\newskip\cvroleskip
\newskip\cvitemskip
\newskip\cvheaderskip
% Negative: an entry's header-to-body break is a plain \\ within the same
% paragraph, which already costs a full \baselineskip with no \parskip on top
% (unlike \cvitemskip below, which adds to one). Trimming it below that
% default is what keeps it visibly tighter than the item-to-item gap even
% though \cvitemskip itself is a small addition.
\cvsubitemskip=-0.3\baselineskip
% Between two roles at one employer. All three of these gaps ride on a
% preceding \\, so they are comparable in baselines: header-to-body is
% \\[\cvsubitemskip] plus the body's own empty \\ line (2 - 0.3 = 1.7),
% employer-to-employer is \\ plus a blank line and so 2 + \parskip (2.4), and
% role-to-role is the single \\ this register rides on (1 + \cvroleskip). It
% has to beat 1.7 or a role's description reads as belonging to the role below
% it rather than the title above it, and stay under 2.4 or a promotion reads as
% a change of employer. One baseline lands squarely between the two.
\cvroleskip=1\baselineskip plus 2pt minus 1pt
\cvitemskip=0.4\baselineskip plus 2pt minus 1pt
\cvheaderskip=1.2\baselineskip plus 3pt minus 2pt
\sectionskip=\cvsectionskip

% Item-to-item separation (each employer in Experience, each degree in Education)
% is an ordinary blank-line paragraph break in those templates, so it is
% \parskip -- not \sectionskip -- that drives it. res.cls sets \parskip to a
% full \baselineskip (see above); lowering the register itself to \cvitemskip
% is what actually shrinks that gap. A local override (e.g. \vskip-\parskip
% mid-item) can't work here: there is no real \par at that point to attach
% to, since each item is one long \\-broken paragraph, not its own paragraph.
\parskip=\cvitemskip

% Bullet-to-bullet spacing inside every \itemize (achievements, awards,
% certifications, skills, ...) comes from \parsep/\itemsep, which res.cls's
% own \@listI sets to 2pt -- already smaller than a paragraph break, but still
% loose against the compact rhythm above. Redefined here, once, rather than
% per list.
\newskip\cvbulletskip
\cvbulletskip=1pt plus 1pt minus 0.5pt
% @ is catcode "other" outside a class/package file, so \@listI would
% otherwise not parse as one control word -- makeatletter/other scope this to
% just the redefinition.
\makeatletter
\def\@listI{\leftmargin\leftmargini
	\topsep 0pt
	\parskip 0pt
	\partopsep 2pt plus 2pt
	\parsep \cvbulletskip
	\itemsep \parsep}
\let\@listi\@listI
\makeatother

{% set fmt_year = "%Y" %}
{#- Abbreviated, not "%B": the employer line carries name, location, dates
   and duration, and at this 5.2in measure full month names push five of
   the real CV's fourteen employers past the margin, each spilling a
   fragment ("months)") onto its own line and costing a page. Applied to
   the whole layout rather than to Experience alone so Education, Awards
   and Publications keep the same date style. ats and txt set their own. #}
{% set fmt_month_year = "%b %Y" %}
{% set fmt_full_date = "%d.%m.%Y" %}

\begin{document}
	\moveleft.5\hoffset\centerline{\huge\bf {{ personal.name | latex_escape }}}
	\moveleft\hoffset\vbox{\hrule width\resumewidth height 1.5pt}
	{% if personal.dob and market.get("show_dob", true) %}
	\moveleft.5\hoffset\centerline{ Date of birth: {{ personal.dob | as_date(fmt_full_date) }}}
	{% endif %}
	{% if personal.address and market.get("show_address", true) %}
	\moveleft.5\hoffset\centerline{ Address: {{ parse_address(personal.address) | latex_escape }}}
	{% endif %}
	{% if personal.nationality and market.get("show_nationality", true) %}
	\moveleft.5\hoffset\centerline{ Nationality: {{ personal.nationality | latex_escape }}}
	{% endif %}
	\moveleft.5\hoffset\centerline{e-mail: {% if links %}\href{mailto:{{ personal.email }}}{ {{ personal.email | latex_escape }}}{% else %}{{ personal.email | latex_escape }}{% endif %} -- Tel: {{ personal.phone | latex_escape }}}
	\moveleft.5\hoffset\centerline{\sl{ {%- if links %}\href{ {{ personal.github }} }{GitHub} -- \href{ {{ personal.linkedin }} }{LinkedIn}{% else %}\weburl{ {{- personal.github -}} } -- \weburl{ {{- personal.linkedin -}} }{% endif -%} }}
	{% if personal.photo and market.get("show_photo", true) %}
	% Zero-height, bottom-anchored box: the photo floats over the empty right
	% flank of the centered header (right edge aligned with the rule) without
	% taking vertical space. Emitted last so it paints over the header rule.
	\moveleft\hoffset\vbox to 0pt{\vss\moveright\dimexpr\resumewidth-1in\relax\hbox{\includegraphics[width=1in]{{ '{' ~ personal.photo ~ '}' }}}}
	{% endif %}

	\begin{resume}

{% set ns = namespace(first_section=true) %}
{% for section in headers %}
	{% if section %}
		{% if ns.first_section %}
		\sectionskip=\cvheaderskip
		\section{ {{ section | title }} }
		\sectionskip=\cvsectionskip
		{% set ns.first_section = false %}
		{% else %}
		\section{ {{ section | title }} }
		{% endif %}
		{% include "sections/" ~ section ~ ".j2" with context %}
	{% endif %}
{% endfor %}

	\end{resume}
	\vfill
	\moveleft\hoffset\vbox{\hrule width\resumewidth height 0.4pt}
	\moveleft.5\hoffset\centerline{\footnotesize{Last updated at {{ now.strftime('%Y-%m-%d') }} -- the most recent copy can be found at {% if links %}\href{ {{ personal.cv_url }}}{ {{ personal.cv_url }}}{% else %}\weburl{ {{- personal.cv_url -}} }{% endif %}}}
	{% if commit_sha %}
	\moveleft.5\hoffset\centerline{\footnotesize{This CV was generated using {% if links %}\href{https://github.com/brunosaboia/cv}{https://github.com/brunosaboia/cv}{% else %}\weburl{https://github.com/brunosaboia/cv}{% endif %}. Commit SHA: {{ commit_sha | latex_escape }}}}
	{% endif %}
\end{document}
